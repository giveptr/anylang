{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anylang",
  "identifier": "anylang",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Anylang",
        "width": 1240,
        "height": 840,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
